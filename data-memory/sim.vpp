#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x102e3f1d0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x102e3c290 .scope module, "dmtb" "dmtb" 3 1;
 .timescale 0 0;
v0x102e450e0_0 .var "address", 7 0;
v0x102e45180_0 .var "clk", 0 0;
v0x102e45220_0 .var "ena", 0 0;
v0x7a42c38000_0 .var/i "i", 31 0;
v0x7a42c380a0_0 .net "read_value", 7 0, v0x102e44fa0_0;  1 drivers
v0x7a42c38140_0 .var "write_value", 7 0;
E_0x102e43ee0 .event negedge, v0x102e44dc0_0;
S_0x102e3c410 .scope module, "dut" "dataMemory" 3 8, 4 1 0, S_0x102e3c290;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "ena";
    .port_info 2 /INPUT 8 "address";
    .port_info 3 /INPUT 8 "write_value";
    .port_info 4 /OUTPUT 8 "read_value";
v0x102e44d20_0 .net "address", 7 0, v0x102e450e0_0;  1 drivers
v0x102e44dc0_0 .net "clk", 0 0, v0x102e45180_0;  1 drivers
v0x102e44e60_0 .net "ena", 0 0, v0x102e45220_0;  1 drivers
v0x102e44f00 .array "mem", 255 0, 7 0;
v0x102e44fa0_0 .var "read_value", 7 0;
v0x102e45040_0 .net "write_value", 7 0, v0x7a42c38140_0;  1 drivers
E_0x102e44000 .event posedge, v0x102e44dc0_0;
    .scope S_0x102e3c410;
T_0 ;
    %wait E_0x102e44000;
    %load/vec4 v0x102e44e60_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x102e45040_0;
    %load/vec4 v0x102e44d20_0;
    %pad/u 10;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x102e44f00, 0, 4;
T_0.0 ;
    %load/vec4 v0x102e44d20_0;
    %pad/u 10;
    %ix/vec4 4;
    %load/vec4a v0x102e44f00, 4;
    %assign/vec4 v0x102e44fa0_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0x102e3c290;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102e45180_0, 0, 1;
    %end;
    .thread T_1, $init;
    .scope S_0x102e3c290;
T_2 ;
    %delay 1, 0;
    %load/vec4 v0x102e45180_0;
    %inv;
    %store/vec4 v0x102e45180_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x102e3c290;
T_3 ;
    %delay 1, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x7a42c38000_0, 0, 32;
T_3.0 ; Top of for-loop
    %load/vec4 v0x7a42c38000_0;
    %cmpi/s 10, 0, 32;
	  %jmp/0xz T_3.1, 5;
    %wait E_0x102e43ee0;
    %vpi_func 3 28 "$urandom" 32 {0 0 0};
    %pad/u 1;
    %store/vec4 v0x102e45220_0, 0, 1;
    %vpi_func 3 29 "$urandom" 32 {0 0 0};
    %pad/u 8;
    %store/vec4 v0x102e450e0_0, 0, 8;
    %vpi_func 3 30 "$urandom" 32 {0 0 0};
    %pad/u 8;
    %store/vec4 v0x7a42c38140_0, 0, 8;
    %wait E_0x102e43ee0;
    %vpi_func 3 33 "$urandom" 32 {0 0 0};
    %pad/u 1;
    %store/vec4 v0x102e45220_0, 0, 1;
    %vpi_func 3 34 "$urandom" 32 {0 0 0};
    %pad/u 8;
    %store/vec4 v0x7a42c38140_0, 0, 8;
T_3.2 ; for-loop step statement
    %load/vec4 v0x7a42c38000_0;
    %addi 1, 0, 32;
    %store/vec4 v0x7a42c38000_0, 0, 32;
    %jmp T_3.0;
T_3.1 ; for-loop exit label
    %delay 1, 0;
    %vpi_call/w 3 41 "$finish" {0 0 0};
    %end;
    .thread T_3;
    .scope S_0x102e3c290;
T_4 ;
    %vpi_call/w 3 48 "$dumpfile", "./waveforms/dmwf.vcd" {0 0 0};
    %vpi_call/w 3 49 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x102e3c290 {0 0 0};
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "./testbenches/dmtb.sv";
