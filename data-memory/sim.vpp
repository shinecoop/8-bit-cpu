v0x776ac74000_0 .net "write_value", 7 0, v0x776ac74460_0;  1 drivers
E_0x100cae480 .event posedge, v0x100cb47e0_0;
L_0x100cb5940 .array/port v0x100cb5800, L_0x100cb59e0;
L_0x100cb59e0 .concat [ 8 2 0 0], v0x776ac740a0_0, L_0x776a854010;
    .scope S_0x100caa450;
T_0 ;
    %wait E_0x100cae480;
    %load/vec4 v0x100cb5760_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x776ac74000_0;
    %load/vec4 v0x100cb4740_0;
    %pad/u 10;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x100cb5800, 0, 4;
T_0.0 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x100caa2d0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x776ac74140_0, 0, 1;
    %end;
    .thread T_1, $init;
    .scope S_0x100caa2d0;
T_2 ;
    %delay 1, 0;
    %load/vec4 v0x776ac74140_0;
    %inv;
    %store/vec4 v0x776ac74140_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x100caa2d0;
T_3 ;
    %delay 1, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x776ac74280_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x776ac74320_0, 0, 32;
T_3.0 ; Top of for-loop
    %load/vec4 v0x776ac74320_0;
    %cmpi/s 10, 0, 32;
	  %jmp/0xz T_3.1, 5;
    %wait E_0x100cb3d90;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x776ac741e0_0, 0, 1;
    %vpi_func 3 31 "$urandom" 32 {0 0 0};
    %pad/u 8;
    %store/vec4 v0x776ac740a0_0, 0, 8;
    %vpi_func 3 32 "$urandom" 32 {0 0 0};
    %pad/u 8;
    %store/vec4 v0x776ac74460_0, 0, 8;
    %wait E_0x100cb3d90;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x776ac741e0_0, 0, 1;
    %load/vec4 v0x776ac743c0_0;
    %load/vec4 v0x776ac74460_0;
    %cmp/ne;
    %jmp/0xz  T_3.3, 4;
    %load/vec4 v0x776ac74280_0;
    %addi 1, 0, 32;
    %store/vec4 v0x776ac74280_0, 0, 32;
T_3.3 ;
T_3.2 ; for-loop step statement
    %load/vec4 v0x776ac74320_0;
    %addi 1, 0, 32;
    %store/vec4 v0x776ac74320_0, 0, 32;
    %jmp T_3.0;
T_3.1 ; for-loop exit label
    %delay 1, 0;
    %load/vec4 v0x776ac74280_0;
    %cmpi/s 0, 0, 32;
    %flag_or 5, 4; GT is !LE
    %flag_inv 5;
    %jmp/0xz  T_3.5, 5;
    %vpi_call/w 3 46 "$display", "FAILED %d RANDOM TESTS", v0x776ac74280_0 {0 0 0};
    %jmp T_3.6;
T_3.5 ;
    %vpi_call/w 3 48 "$display", "PASSED ALL RANDOM TESTS" {0 0 0};
T_3.6 ;
    %vpi_call/w 3 50 "$finish" {0 0 0};
    %end;
    .thread T_3;
    .scope S_0x100caa2d0;
T_4 ;
    %vpi_call/w 3 57 "$dumpfile", "./waveforms/dmwf.vcd" {0 0 0};
    %vpi_call/w 3 58 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x100caa2d0 {0 0 0};
    %end;
    .thread T_4;
